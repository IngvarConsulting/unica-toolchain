{
  "schemaVersion": 3,
  "name": "bsl-analyzer",
  "version": "0.4.6",
  "buildRevision": 1,
  "source": {
    "kind": "release",
    "repository": "https://github.com/itrous/bsl-analyzer",
    "ref": "v0.4.6",
    "commit": "0a82ed78e597dc3ffb1bbaebc66a98974a988435"
  },
  "license": {
    "spdx": "MIT",
    "files": [
      {"path": "LICENSE-MIT", "assetName": "license-bsl-analyzer-MIT.txt"},
      {"path": "NOTICE", "assetName": "notice-bsl-analyzer.txt"}
    ]
  },
  "patches": [],
  "builder": {
    "kind": "cargo",
    "rustVersion": "1.95.0",
    "locked": true,
    "binaries": [
      {
        "package": "bsl-analyzer",
        "sourceName": "bsl-analyzer-app",
        "assetBase": "bsl-analyzer",
        "smokeArgs": ["--help"]
      }
    ]
  },
  "targets": {
    "darwin-arm64": {
      "runner": "macos-15",
      "targetTriple": "aarch64-apple-darwin",
      "exe": "",
      "systemSetup": "none",
      "environment": {}
    },
    "linux-x64": {
      "runner": "ubuntu-22.04",
      "targetTriple": "x86_64-unknown-linux-gnu",
      "exe": "",
      "systemSetup": "gcc-12",
      "environment": {
        "CC": "gcc-12",
        "CXX": "g++-12"
      }
    },
    "win-x64": {
      "runner": "windows-latest",
      "targetTriple": "x86_64-pc-windows-msvc",
      "exe": ".exe",
      "systemSetup": "none",
      "environment": {
        "CXXFLAGS": "/DMAP_FAILED=((void*)-1)",
        "RUSTFLAGS": "-C target-feature=+crt-static"
      }
    }
  }
}
