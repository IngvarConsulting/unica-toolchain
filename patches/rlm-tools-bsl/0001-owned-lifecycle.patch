+++ b/tests/test_unica_lifecycle_contract.py
@@ -0,0 +1,420 @@
+"""Owned #1119 deadline/owner contract; real SDK/backend paths, no replacement engine."""
+
+import json
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from _process_test_utils import make_cf_project
+from rlm_tools_bsl import server
+from rlm_tools_bsl import session as session_module
+from rlm_tools_bsl import sandbox as sandbox_module
+from rlm_tools_bsl._sandbox_protocol import SandboxProtocolError, decode_frame
+from rlm_tools_bsl.sandbox import Sandbox
+from rlm_tools_bsl.sandbox_backend import InlineSandboxBackend
+from rlm_tools_bsl.session import SessionManager
+
+
+def test_inline_close_after_grace_retains_actual_running_execution(tmp_path):
+    sandbox = Sandbox(base_path=str(tmp_path), execution_timeout_seconds=45)
+    backend = InlineSandboxBackend(sandbox, None, install_llm_tools=False)
+    entered, release = threading.Event(), threading.Event()
+    result = []
+
+    def actual_execution_gate():
+        entered.set()
+        assert release.wait(5), "test watchdog: release actual execution"
+
+    sandbox._namespace["actual_execution_gate"] = actual_execution_gate
+    worker = threading.Thread(target=lambda: result.append(backend.execute("actual_execution_gate(); print('winner')")))
+    worker.start()
+    try:
+        assert entered.wait(5), "real Sandbox.execute never reached gate"
+        assert backend._executing and worker.is_alive()
+        backend.request_close("explicit_end")
+        report = backend.finish_close(time.monotonic() - 1)
+        observed = (report.closed, report.residual, backend.state, backend._executing, worker.is_alive())
+    finally:
+        release.set()
+        worker.join(5)
+        backend.finish_close(time.monotonic() + 5)
+    assert not worker.is_alive()
+    assert observed == (False, True, "closing", True, True), "stop observation grace lost live inline ownership"
+    assert len(result) == 1 and result[0].stdout == "winner\n"
+
+
+def _real_inline_session(monkeypatch, tmp_path):
+    manager = SessionManager(timeout_idle_minutes=1, timeout_active_minutes=1)
+    manager.on_evict = server._release_session_resources
+    monkeypatch.setattr(server, "session_manager", manager)
+    monkeypatch.setenv("RLM_SANDBOX_MODE", "inline")
+    response = json.loads(server._rlm_start(path=make_cf_project(tmp_path / "cf"), query="owner retention"))
+    assert "error" not in response, response
+    sid = response["session_id"]
+    session = manager.get(sid)
+    with server._sandboxes_lock:
+        backend = server._sandboxes[sid]
+    return manager, sid, session, backend
+
+
+def test_real_active_execution_survives_session_ttl_cleanup(monkeypatch, tmp_path):
+    manager, sid, session, backend = _real_inline_session(monkeypatch, tmp_path)
+    entered, release = threading.Event(), threading.Event()
+    result = []
+
+    def actual_execution_gate():
+        entered.set()
+        assert release.wait(5), "test watchdog: release actual execution"
+
+    backend._sandbox._namespace["actual_execution_gate"] = actual_execution_gate
+    worker = threading.Thread(
+        target=lambda: result.append(
+            json.loads(server._rlm_execute(sid, "actual_execution_gate(); print('winner')", detail_level="full"))
+        )
+    )
+    worker.start()
+    try:
+        assert entered.wait(5)
+        assert backend._executing and session.execute_calls == 1
+        expired_epoch = session.last_used + 3600
+        monkeypatch.setattr(session_module, "time", SimpleNamespace(time=lambda: expired_epoch))
+        server._cleanup_expired_resources()
+        with manager._lock:
+            retained_session = manager._sessions.get(sid)
+        with server._sandboxes_lock:
+            retained_backend = server._sandboxes.get(sid)
+        snapshot = (retained_session is session, retained_backend is backend, backend.state)
+    finally:
+        release.set()
+        worker.join(5)
+        server._rlm_end(sid)
+    assert not worker.is_alive()
+    assert snapshot == (True, True, "executing"), "TTL cleanup revoked accepted running work"
+    assert len(result) == 1 and result[0]["error"] is None and result[0]["stdout"] == "winner\n"
+
+
+def test_queued_execution_is_retained_after_previous_execution_completes(monkeypatch, tmp_path):
+    manager, sid, session, backend = _real_inline_session(monkeypatch, tmp_path)
+    entered, release_first = threading.Event(), threading.Event()
+    queued, release_queue = threading.Event(), threading.Event()
+    original_lock = session.execution_lock
+    results = {}
+
+    class ObservedExecutionLock:
+        def __enter__(self):
+            if threading.current_thread().name == "owned-queued-execution":
+                queued.set()
+                assert release_queue.wait(5), "test watchdog: release queued lock observation"
+            original_lock.acquire()
+            return self
+
+        def __exit__(self, *exc):
+            original_lock.release()
+
+    session.execution_lock = ObservedExecutionLock()
+
+    def actual_execution_gate():
+        entered.set()
+        assert release_first.wait(5), "test watchdog: release first actual execution"
+
+    backend._sandbox._namespace["actual_execution_gate"] = actual_execution_gate
+    first = threading.Thread(
+        target=lambda: results.update(
+            first=json.loads(server._rlm_execute(sid, "actual_execution_gate(); print('first')"))
+        )
+    )
+    second = threading.Thread(
+        name="owned-queued-execution",
+        target=lambda: results.update(second=json.loads(server._rlm_execute(sid, "print('second')"))),
+    )
+    first.start()
+    try:
+        assert entered.wait(5)
+        second.start()
+        assert queued.wait(5), "second call did not reach the occupied execution lane"
+        release_first.set()
+        first.join(5)
+        assert not first.is_alive() and results["first"]["error"] is None
+        assert not backend._executing and second.is_alive()
+        expired_epoch = session.last_used + 3600
+        monkeypatch.setattr(session_module, "time", SimpleNamespace(time=lambda: expired_epoch))
+        server._cleanup_expired_resources()
+        with manager._lock:
+            retained_session = manager._sessions.get(sid)
+        with server._sandboxes_lock:
+            retained_backend = server._sandboxes.get(sid)
+        snapshot = (retained_session is session, retained_backend is backend)
+    finally:
+        release_first.set()
+        release_queue.set()
+        first.join(5)
+        if second.ident is not None:
+            second.join(5)
+        server._rlm_end(sid)
+    assert not first.is_alive() and not second.is_alive()
+    assert snapshot == (True, True), "TTL cleanup revoked a queued accepted call after running call finished"
+    assert results["second"]["error"] is None and results["second"]["stdout"] == "second\n"
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        b'{"protocol_version":1,"type":"ping","type":"execute","request_id":1,"generation":1}',
+        b'{"protocol_version":1,"type":"init","request_id":1,"generation":1,"payload":{"operation_deadline":{"mode":"none","mode":"finite"}}}',
+    ],
+)
+def test_ipc_duplicate_fields_cannot_choose_a_different_deadline_or_command(raw):
+    with pytest.raises(SandboxProtocolError, match="duplicate"):
+        decode_frame(raw, 1024 * 1024)
+
+
+def test_execute_pins_registered_session_before_backend_lookup(monkeypatch, tmp_path):
+    manager, sid, session, backend = _real_inline_session(monkeypatch, tmp_path)
+    lookup_entered, release_lookup = threading.Event(), threading.Event()
+    original_lock = server._sandboxes_lock
+    result = []
+
+    class ObservedBackendRegistryLock:
+        def __enter__(self):
+            if threading.current_thread().name == "owned-backend-lookup":
+                lookup_entered.set()
+                assert release_lookup.wait(5), "test watchdog: release backend lookup"
+            original_lock.acquire()
+            return self
+
+        def __exit__(self, *exc):
+            original_lock.release()
+
+    monkeypatch.setattr(server, "_sandboxes_lock", ObservedBackendRegistryLock())
+    worker = threading.Thread(
+        name="owned-backend-lookup",
+        target=lambda: result.append(json.loads(server._rlm_execute(sid, "print('lookup-owner')"))),
+    )
+    worker.start()
+    try:
+        assert lookup_entered.wait(5), "execute did not reach real backend lookup"
+        expired_epoch = session.last_used + 3600
+        monkeypatch.setattr(session_module, "time", SimpleNamespace(time=lambda: expired_epoch))
+        server._cleanup_expired_resources()
+        with manager._lock:
+            retained_session = manager._sessions.get(sid)
+        with original_lock:
+            retained_backend = server._sandboxes.get(sid)
+        observed = (retained_session is session, retained_backend is backend)
+    finally:
+        release_lookup.set()
+        worker.join(5)
+        server._rlm_end(sid)
+    assert not worker.is_alive()
+    assert observed == (True, True), "session was revoked between registration lookup and backend lookup"
+    assert len(result) == 1 and result[0]["error"] is None and result[0]["stdout"] == "lookup-owner\n"
+
+
+def test_legacy_idle_session_without_consumers_still_expires(monkeypatch, tmp_path):
+    manager, sid, session, backend = _real_inline_session(monkeypatch, tmp_path)
+    expired_epoch = session.last_used + 3600
+    monkeypatch.setattr(session_module, "time", SimpleNamespace(time=lambda: expired_epoch))
+    server._cleanup_expired_resources()
+    with manager._lock:
+        assert sid not in manager._sessions
+    with server._sandboxes_lock:
+        assert sid not in server._sandboxes
+    assert backend.state == "closed"
