+def test_startup_session_is_retained_before_backend_registration(monkeypatch, tmp_path):
+    manager = SessionManager(timeout_idle_minutes=1, timeout_active_minutes=1)
+    manager.on_evict = server._release_session_resources
+    monkeypatch.setattr(server, "session_manager", manager)
+    monkeypatch.setenv("RLM_SANDBOX_MODE", "inline")
+    factory_entered, release_factory = threading.Event(), threading.Event()
+    original_factory = server._create_session_backend
+    response = []
+
+    def held_factory(*args, **kwargs):
+        factory_entered.set()
+        assert release_factory.wait(5), "test watchdog: release actual backend factory"
+        return original_factory(*args, **kwargs)
+
+    monkeypatch.setattr(server, "_create_session_backend", held_factory)
+    worker = threading.Thread(
+        target=lambda: response.append(
+            json.loads(server._rlm_start(path=make_cf_project(tmp_path / "cf"), query="startup owner"))
+        )
+    )
+    worker.start()
+    sid = None
+    try:
+        assert factory_entered.wait(5), "real start did not reach backend constructor"
+        with manager._lock:
+            assert len(manager._sessions) == 1
+            sid, session = next(iter(manager._sessions.items()))
+        expired_epoch = session.last_used + 3600
+        monkeypatch.setattr(session_module, "time", SimpleNamespace(time=lambda: expired_epoch))
+        server._cleanup_expired_resources()
+        with manager._lock:
+            retained = manager._sessions.get(sid) is session
+    finally:
+        release_factory.set()
+        worker.join(5)
+        if sid is not None:
+            server._rlm_end(sid)
+    assert not worker.is_alive()
+    assert retained, "TTL revoked accepted startup before backend registration"
+    assert len(response) == 1 and "error" not in response[0]
+
+
+def test_explicit_end_during_execution_does_not_reinsert_on_late_reply(monkeypatch, tmp_path):
+    manager, sid, session, backend = _real_inline_session(monkeypatch, tmp_path)
+    entered, release = threading.Event(), threading.Event()
+    replies = []
+
+    def actual_execution_gate():
+        entered.set()
+        assert release.wait(5), "test watchdog: release revoked inline execution"
+
+    backend._sandbox._namespace["actual_execution_gate"] = actual_execution_gate
+    worker = threading.Thread(
+        target=lambda: replies.append(
+            json.loads(server._rlm_execute(sid, "actual_execution_gate(); print('late-owner')"))
+        )
+    )
+    worker.start()
+    try:
+        assert entered.wait(5)
+        assert json.loads(server._rlm_end(sid)) == {"success": True}
+        with manager._lock:
+            assert sid not in manager._sessions
+        with server._sandboxes_lock:
+            assert sid not in server._sandboxes
+        assert backend._executing and worker.is_alive()
+        rejected = json.loads(server._rlm_execute(sid, "print('no replacement')"))
+        assert rejected["error"]
+    finally:
+        release.set()
+        worker.join(5)
+        backend.finish_close(time.monotonic() + 5)
+    assert not worker.is_alive()
+    assert len(replies) == 1
+    with manager._lock:
+        assert sid not in manager._sessions
+    with server._sandboxes_lock:
+        assert sid not in server._sandboxes
+    assert backend.state == "closed"
+
