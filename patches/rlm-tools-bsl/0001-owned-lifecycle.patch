+def test_explicit_close_revokes_distinct_inline_session_waiting_for_global_stdout(monkeypatch, tmp_path):
+    first_sandbox = Sandbox(base_path=str(tmp_path), execution_timeout_seconds=45)
+    second_sandbox = Sandbox(base_path=str(tmp_path), execution_timeout_seconds=45)
+    first_backend = InlineSandboxBackend(first_sandbox, None, install_llm_tools=False)
+    second_backend = InlineSandboxBackend(second_sandbox, None, install_llm_tools=False)
+    first_entered, release_first, second_waiting = threading.Event(), threading.Event(), threading.Event()
+    side_effects, outcomes = [], {}
+    original_stdout_lock = sandbox_module._INLINE_STDOUT_LOCK
+
+    class ObservedStdoutLock:
+        def __enter__(self):
+            if threading.current_thread().name == "second-inline-global-wait":
+                second_waiting.set()
+            original_stdout_lock.acquire()
+            return self
+
+        def __exit__(self, *exc):
+            original_stdout_lock.release()
+
+    monkeypatch.setattr(sandbox_module, "_INLINE_STDOUT_LOCK", ObservedStdoutLock())
+
+    def actual_first_gate():
+        first_entered.set()
+        assert release_first.wait(5), "test watchdog: release global stdout owner"
+
+    first_sandbox._namespace["actual_first_gate"] = actual_first_gate
+    second_sandbox._namespace["forbidden_side_effect"] = lambda: side_effects.append("revoked code ran")
+
+    def execute_and_capture(key, backend, code):
+        try:
+            outcomes[key] = backend.execute(code)
+        except Exception as exc:
+            outcomes[key] = exc
+
+    first = threading.Thread(
+        target=execute_and_capture, args=("first", first_backend, "actual_first_gate(); print('first-owner')")
+    )
+    second = threading.Thread(
+        name="second-inline-global-wait",
+        target=execute_and_capture,
+        args=("second", second_backend, "forbidden_side_effect(); print('revoked')"),
+    )
+    first.start()
+    try:
+        assert first_entered.wait(5)
+        second.start()
+        assert second_waiting.wait(5), "second distinct session did not queue at actual global stdout lock"
+        assert second_backend._executing and second.is_alive()
+        second_backend.request_close("explicit_end_while_queued")
+    finally:
+        release_first.set()
+        first.join(5)
+        if second.ident is not None:
+            second.join(5)
+        first_backend.request_close("test_cleanup")
+        second_backend.request_close("test_cleanup")
+        first_backend.finish_close(time.monotonic() + 5)
+        second_backend.finish_close(time.monotonic() + 5)
+    assert not first.is_alive() and not second.is_alive()
+    assert not side_effects, "explicitly revoked queued inline code executed after another session released stdout"
+    assert outcomes["first"].error is None and outcomes["first"].stdout == "first-owner\n"
+    stopped = outcomes["second"]
+    assert isinstance(stopped, Exception) or stopped.error is not None
+
+
+def test_late_lease_release_does_not_touch_new_session_with_reused_identifier(monkeypatch, tmp_path):
+    manager = SessionManager()
+    sid, lease = manager.create_retained(str(tmp_path), "old owner")
+    original = lease.session
+    manager.end(sid)
+    monkeypatch.setattr(session_module.uuid, "uuid4", lambda: SimpleNamespace(hex=sid + "0" * 20))
+    replacement_id = manager.create(str(tmp_path), "new owner")
+    assert replacement_id == sid
+    with manager._lock:
+        replacement = manager._sessions[sid]
+    assert replacement is not original and replacement.query == "new owner"
+    before = (replacement.created_at, replacement.last_used, replacement._operation_pins)
+    monkeypatch.setattr(session_module, "time", SimpleNamespace(time=lambda: replacement.last_used + 1234))
+    lease.close()
+    lease.close()
+    with manager._lock:
+        assert manager._sessions[sid] is replacement
+    assert (replacement.created_at, replacement.last_used, replacement._operation_pins) == before
+    assert original._operation_pins == 0
+
+
+def test_failed_start_releases_retained_lease_without_keeping_idle_session(monkeypatch, tmp_path):
+    manager = SessionManager()
+    manager.on_evict = server._release_session_resources
+    monkeypatch.setattr(server, "session_manager", manager)
+    monkeypatch.setenv("RLM_SANDBOX_MODE", "inline")
+    created = []
+    real_create = manager.create_retained
+
+    def observed_create(*args, **kwargs):
+        sid, lease = real_create(*args, **kwargs)
+        created.append((sid, lease.session))
+        return sid, lease
+
+    def refused_factory(*args, **kwargs):
+        raise RuntimeError("controlled backend initialization refusal")
+
+    monkeypatch.setattr(manager, "create_retained", observed_create)
+    monkeypatch.setattr(server, "_create_session_backend", refused_factory)
+    reply = json.loads(server._rlm_start(path=make_cf_project(tmp_path / "cf"), query="failed startup"))
+    assert "controlled backend initialization refusal" in reply["error"]
+    assert len(created) == 1
+    sid, session = created[0]
+    assert session._operation_pins == 0
+    with manager._lock:
+        assert sid not in manager._sessions
+    with server._sandboxes_lock:
+        assert sid not in server._sandboxes
