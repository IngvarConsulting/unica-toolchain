+def _owned_cf_project(tmp_path):
+    # The real detector scans parent and grandparent. Both belong to this fixture.
+    return make_cf_project(tmp_path / "group" / "neighborhood" / "cf")
+
+
+def test_owned_startup_fixture_keeps_real_detector_neighborhood_private(monkeypatch, tmp_path):
+    from pathlib import Path
+    from rlm_tools_bsl import extension_detector
+
+    owner = tmp_path / "owner"
+    foreign = tmp_path / "foreign"
+    foreign.mkdir()
+    (foreign / "Configuration.xml").write_text(
+        "<MetaDataObject><Configuration><Properties><Name>Foreign</Name>"
+        "</Properties></Configuration></MetaDataObject>", encoding="utf-8"
+    )
+    real_detect_all = extension_detector._detect_all
+    scans = []
+
+    def observe_detect_all(directory):
+        result = real_detect_all(directory)
+        scans.append((Path(directory).resolve(), tuple(Path(info.path).resolve() for info in result)))
+        return result
+
+    monkeypatch.setattr(extension_detector, "_detect_all", observe_detect_all)
+    extension_detector.detect_extension_context(make_cf_project(owner / "cf"))
+    assert any(path == foreign.resolve() and foreign.resolve() in results for path, results in scans), scans
+    scans.clear()
+    extension_detector.detect_extension_context(_owned_cf_project(owner))
+    assert scans, "the real detector did not inspect its owned neighborhood"
+    assert all(path.is_relative_to(owner.resolve()) for path, _ in scans), scans
+    assert all(foreign.resolve() not in results for _, results in scans), scans
+
+
